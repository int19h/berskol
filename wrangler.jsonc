{
  "name": "berskol",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "worker_loaders": [{ "binding": "LOADER" }],
  "kv_namespaces": [{ "binding": "CACHE", "id": "cc3586a0ed4e4c628556db4898ae42d7" }],
  "routes": [{ "pattern": "berskol.app", "custom_domain": true }],
  "workers_dev": true,
  "observability": { "enabled": true },
  "triggers": { "crons": ["23 */6 * * *"] },
  "unsafe": {
    "bindings": [
      {
        "name": "RL",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 300, "period": 60 }
      }
    ]
  }
}
